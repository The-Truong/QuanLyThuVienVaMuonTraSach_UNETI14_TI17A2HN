@{
    var curController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var curAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string Active(string controller, string? action = null)
    {
        return curController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && (action == null || curAction.Equals(action, StringComparison.OrdinalIgnoreCase))
                ? "active"
                : "";
    }
}

